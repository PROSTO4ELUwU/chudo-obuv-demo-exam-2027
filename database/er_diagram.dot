digraph er_diagram {
    graph [rankdir=LR, nodesep=0.35, ranksep=1.1, pad=0.3, fontname="Calibri",
           labelloc=t, fontsize=20, label=<<B>ER-диаграмма базы данных «Чудо Обувь»</B><BR/><FONT POINT-SIZE="12">PK — первичный ключ, FK — внешний ключ; связи «один ко многим» в нотации «воронья лапка»</FONT>>];
    node [shape=plain, fontname="Calibri", fontsize=11];
    edge [dir=both, arrowtail=crowodot, arrowhead=teetee, color="#444444"];
    categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">category_id</TD><TD ALIGN="LEFT" PORT="category_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name_in"></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT" PORT="category_name_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR></TABLE>>];
    manufacturers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>manufacturers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">manufacturer_id</TD><TD ALIGN="LEFT" PORT="manufacturer_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer_name_in"></TD><TD ALIGN="LEFT">manufacturer_name</TD><TD ALIGN="LEFT" PORT="manufacturer_name_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR></TABLE>>];
    order_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_item_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">order_item_id</TD><TD ALIGN="LEFT" PORT="order_item_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_in">FK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT" PORT="order_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_item_id_in">FK</TD><TD ALIGN="LEFT">stock_item_id</TD><TD ALIGN="LEFT" PORT="stock_item_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_in"></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price_in"></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT" PORT="unit_price_out"><FONT COLOR="#555555">numeric(10,2)</FONT></TD></TR></TABLE>>];
    orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">order_id</TD><TD ALIGN="LEFT" PORT="order_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date_in"></TD><TD ALIGN="LEFT">order_date</TD><TD ALIGN="LEFT" PORT="order_date_out"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="client_id_in">FK</TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="client_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR></TABLE>>];
    products [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">product_id</TD><TD ALIGN="LEFT" PORT="product_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_name_in"></TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT" PORT="product_name_out"><FONT COLOR="#555555">character varying(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_in">FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subcategory_id_in">FK</TD><TD ALIGN="LEFT">subcategory_id</TD><TD ALIGN="LEFT" PORT="subcategory_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer_id_in">FK</TD><TD ALIGN="LEFT">manufacturer_id</TD><TD ALIGN="LEFT" PORT="manufacturer_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_in"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_out"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="composition_in"></TD><TD ALIGN="LEFT">composition</TD><TD ALIGN="LEFT" PORT="composition_out"><FONT COLOR="#555555">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_in"></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT" PORT="price_out"><FONT COLOR="#555555">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_file_in"></TD><TD ALIGN="LEFT">image_file</TD><TD ALIGN="LEFT" PORT="image_file_out"><FONT COLOR="#555555">character varying(255)</FONT></TD></TR></TABLE>>];
    roles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">role_id</TD><TD ALIGN="LEFT" PORT="role_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_name_in"></TD><TD ALIGN="LEFT">role_name</TD><TD ALIGN="LEFT" PORT="role_name_out"><FONT COLOR="#555555">character varying(50)</FONT></TD></TR></TABLE>>];
    sizes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>sizes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">size_id</TD><TD ALIGN="LEFT" PORT="size_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_value_in"></TD><TD ALIGN="LEFT">size_value</TD><TD ALIGN="LEFT" PORT="size_value_out"><FONT COLOR="#555555">numeric(3,1)</FONT></TD></TR></TABLE>>];
    stock_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>stock_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_item_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">stock_item_id</TD><TD ALIGN="LEFT" PORT="stock_item_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id_in">FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT" PORT="product_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_id_in">FK</TD><TD ALIGN="LEFT">size_id</TD><TD ALIGN="LEFT" PORT="size_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_in"></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#555555">integer</FONT></TD></TR></TABLE>>];
    subcategories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>subcategories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subcategory_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">subcategory_id</TD><TD ALIGN="LEFT" PORT="subcategory_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subcategory_name_in"></TD><TD ALIGN="LEFT">subcategory_name</TD><TD ALIGN="LEFT" PORT="subcategory_name_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR></TABLE>>];
    users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#70B2AF"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_in" BGCOLOR="#D2F6E7">PK</TD><TD ALIGN="LEFT" BGCOLOR="#D2F6E7">user_id</TD><TD ALIGN="LEFT" PORT="user_id_out" BGCOLOR="#D2F6E7"><FONT COLOR="#555555">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name_in"></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="last_name_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name_in"></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="first_name_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="patronymic_in"></TD><TD ALIGN="LEFT">patronymic</TD><TD ALIGN="LEFT" PORT="patronymic_out"><FONT COLOR="#555555">character varying(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="login_in"></TD><TD ALIGN="LEFT">login</TD><TD ALIGN="LEFT" PORT="login_out"><FONT COLOR="#555555">character varying(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id_in">FK</TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#555555">integer</FONT></TD></TR></TABLE>>];
    order_items:order_id_out:e -> orders:order_id_in:w;
    order_items:stock_item_id_out:e -> stock_items:stock_item_id_in:w;
    orders:client_id_out:e -> users:user_id_in:w;
    products:category_id_out:e -> categories:category_id_in:w;
    products:manufacturer_id_out:e -> manufacturers:manufacturer_id_in:w;
    products:subcategory_id_out:e -> subcategories:subcategory_id_in:w;
    stock_items:product_id_out:e -> products:product_id_in:w;
    stock_items:size_id_out:e -> sizes:size_id_in:w;
    users:role_id_out:e -> roles:role_id_in:w;
}
